# Copy to services/.env for `npm run dev` on your PC. services/.env is ignored by git.
# The services talk to Floci (DynamoDB, S3) exactly like the Lambdas do.
PORT=3000
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Same values as infra/deploy.env
JWT_SECRET=
INTERNAL_TOKEN=
ADMIN_EMAILS=admin@example.com
DATABASE_URL=
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Loan Tracker

CORS_ORIGINS=http://localhost:3000,http://localhost:4566
APP_TIMEZONE=Africa/Cairo
