# Copy this file to infra/deploy.env and fill it in. deploy.env is in .gitignore: NEVER commit it.
# infra/05-secrets.sh moves these values into AWS Secrets Manager (encrypted with a KMS key).
# The Lambda functions never see them as plain environment variables.

# Emails that become ADMIN (lender) when they register, comma separated
ADMIN_EMAILS=admin@example.com

# Neon Postgres connection string for the users table (leave empty to keep users in DynamoDB)
# Neon console > your project > Connect > copy the connection string
DATABASE_URL=

# Brevo email API (leave BREVO_API_KEY empty to only log emails in CloudWatch)
# Brevo > SMTP & API > API Keys. EMAIL_FROM must be a sender you verified in Brevo.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Loan Tracker

# Lender alerts: escalations of long-overdue plans also go to this email (plus the SNS topic)
ALERT_EMAIL=
ESCALATION_DAYS=14

# Optional
APP_TIMEZONE=Africa/Cairo
DEFAULT_REMINDER_DAYS=3,1
# Daily job time (EventBridge Scheduler cron, in APP_TIMEZONE)
REMINDER_CRON=cron(0 9 * * ? *)
# JWT_SECRET / INTERNAL_TOKEN: leave empty, 05-secrets.sh generates them once (rotate with rotate-secrets.sh)
JWT_SECRET=
INTERNAL_TOKEN=
# Only if Lambda functions cannot reach Floci by themselves (see README > Troubleshooting)
LAMBDA_AWS_ENDPOINT=
